{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run build:ingest && npm run build:analytics",
    "build:ingest": "nest build ingest-service",
    "build:analytics": "nest build analytics-service",
    "start:ingest": "nest start ingest-service --watch",
    "start:analytics": "nest start analytics-service --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint \"{apps,libs}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/microservices": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "mongodb": "^7.7.0",
    "multer": "^2.4.0",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stream-chain": "^2.2.5",
    "stream-json": "^1.9.1"
